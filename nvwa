#!/usr/bin/env bash
# nvwa — the Nüwa Foundation CLI: Create + Language + History for any agent swarm.
#
# Three capabilities, one command:
#   Create   nvwa spawn [--name w1] [--agent claude] [--mission "..."]
#   Language nvwa say <name> "<text>"     — send to an agent
#            nvwa listen <name> [lines]   — read from an agent
#   History  nvwa fact / nvwa intent / nvwa status / nvwa graph / nvwa recall ...
#            (delegated to the fgc fact-intent graph, same shared memory)
#
# The substrate is tmux: one pane per agent, send-keys -l for reliable text
# injection, capture-pane for reading. Any interactive CLI agent works —
# claude, codex, gemini, or your own script.
#
# Usage:
#   nvwa spawn --name worker1 --mission "read the graph, then explore intent i001"
#   nvwa say worker1 "what did you find?"
#   nvwa listen worker1 40
#   nvwa list
#   nvwa board
#   nvwa kill worker1
#
# Graph commands are identical to `fgc` (same CLI, same store):
#   nvwa fact "confirmed observation" -k note
#   nvwa intent --from f001 "next step"
#   nvwa status
#   nvwa dispatch reason
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
FGC="${FGC_BIN:-fgc}"
SESSION="${NVWA_SESSION:-nvwa}"
ROOT="${NVWA_ROOT:-$PWD/.nvwa}"
MAX_WORKERS="${NVWA_MAX_WORKERS:-8}"
mkdir -p "$ROOT"

log() { printf '[nvwa] %s\n' "$*" >&2; }
die() { printf '[nvwa] ERROR: %s\n' "$*" >&2; exit 1; }

WORKERS_DIR="$ROOT/workers"   # one <name>.tier tag per live worker (tiering)

# Run a graph command via the fgc CLI if present, else the bundled lib/fg.py.
fgc_call() {
  if command -v "$FGC" >/dev/null 2>&1; then
    "$FGC" "$@"
  else
    python3 "$SCRIPT_DIR/lib/fg.py" "$@"
  fi
}

# Count strong-tier workers still live, pruning tags whose tmux window is gone.
count_active_strong() {
  local n=0 f wn live
  [[ -d "$WORKERS_DIR" ]] || { echo 0; return 0; }
  live=$(tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null || true)
  for f in "$WORKERS_DIR"/*.tier; do
    [[ -e "$f" ]] || continue
    wn=$(basename "$f" .tier)
    if ! printf '%s\n' "$live" | grep -qx -- "$wn"; then rm -f "$f"; continue; fi
    [[ "$(cat "$f" 2>/dev/null)" == "strong" ]] && n=$((n+1))
  done
  echo "$n"
}

# ─── tmux primitives (same rules as sapper: send-keys -l only, never paste) ──
pane_text()   { tmux capture-pane -pt "$SESSION:$1" 2>/dev/null; }

send_literal() {
  # send text, then Enter — then VERIFY the input box is empty again; the CLI
  # can swallow the first Enter while still rendering long pasted text, so a
  # message would sit unsubmitted forever. Bounded re-Enter until the prompt
  # line is blank (mission-confirmation, same lesson as sapper's worker.sh).
  local name="$1" text="$2" i pane
  tmux send-keys -t "$SESSION:$name" -l -- "$text"
  sleep 0.5
  tmux send-keys -t "$SESSION:$name" Enter
  for i in 1 2 3 4; do
    sleep 0.8
    pane=$(tmux capture-pane -pt "$SESSION:$name" 2>/dev/null || true)
    if printf '%s' "$pane" | tail -10 | grep -qE '^❯[[:space:]]*$'; then
      return 0
    fi
    tmux send-keys -t "$SESSION:$name" Enter
  done
  log "$name: WARNING — input box not confirmed empty after send; message may be unsubmitted (inspect the pane)"
  return 1
}

accept_dialogs() {
  local name="$1" pane="$2"
  if printf '%s' "$pane" | grep -qE 'Enter to confirm|Yes, I accept|I accept'; then
    if printf '%s' "$pane" | grep -qE '❯[^\n]*No, exit'; then
      tmux send-keys -t "$SESSION:$name" Down; sleep 0.3
    fi
    tmux send-keys -t "$SESSION:$name" Enter; sleep 1
    return 0
  fi
  return 1
}

wait_input_box() {
  local name="$1" waited=0 pane=""
  while (( waited < 60 )); do
    pane=$(pane_text "$name")
    accept_dialogs "$name" "$pane" && { waited=$((waited+2)); continue; }
    printf '%s' "$pane" | grep -q '❯' && return 0
    sleep 1; waited=$((waited+1))
  done
  return 1
}

# ─── Create: spawn a new AI agent ────────────────────────────────────────────
cmd_spawn() {
  local name="" agent="${NVWA_AGENT:-claude}" mission="" minutes="" a
  local tier="" role="" model=""
  while (( $# )); do
    a=$1; shift
    case "$a" in
      --name)    name="$1"; shift ;;
      --agent)   agent="$1"; shift ;;
      --mission) mission="$1"; shift ;;
      --minutes) minutes="$1"; shift ;;
      --tier)    tier="$1"; shift ;;
      --role)    role="$1"; shift ;;
      --model)   model="$1"; shift ;;
      -*) die "spawn: unknown option $a" ;;
      *)  [[ -z "$name" ]] && name="$a" || die "spawn: unexpected argument $a" ;;
    esac
  done
  [[ -n "$name" ]] || { local n=1; while tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -qx "w$n"; do n=$((n+1)); done; name="w$n"; }
  [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "spawn: name must be [A-Za-z0-9_-]"

  # session + pane cap
  tmux has-session -t "$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION"
  local nw; nw=$(tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -vc '^nvwa$' || echo 0)
  (( nw >= MAX_WORKERS )) && die "CAP: $nw/$MAX_WORKERS agents — nvwa kill one first"

  # resolve the model tier (role default: worker -> cheap) and enforce the
  # strong-concurrency cap BEFORE committing a window.
  local active_strong; active_strong=$(count_active_strong)
  local -a targ=(tier can-spawn --active-strong "$active_strong")
  [[ -n "$role"  ]] && targ+=(--role "$role")
  [[ -n "$tier"  ]] && targ+=(--tier "$tier")
  [[ -n "$model" ]] && targ+=(--model "$model")
  local resolve_out rc
  resolve_out=$(fgc_call "${targ[@]}" 2>&1); rc=$?
  (( rc != 0 )) && die "${resolve_out#fgc: }"
  local r_tier="" r_model="" r_base="" r_token="" k v
  while IFS=$'\t' read -r k v; do
    case "$k" in
      tier)     r_tier="$v" ;;
      model)    r_model="$v" ;;
      base_url) r_base="$v" ;;
      token)    r_token="$v" ;;
    esac
  done <<< "$resolve_out"

  # kill stale window if re-spawning same name
  tmux kill-window -t "$SESSION:$name" 2>/dev/null

  # launch the agent, injecting the tier's model/endpoint via env for any
  # Anthropic-compatible CLI (empty vars are simply omitted)
  local launch_env=""
  [[ -n "$r_model" ]] && launch_env+="ANTHROPIC_MODEL=$(printf %q "$r_model") "
  [[ -n "$r_base"  ]] && launch_env+="ANTHROPIC_BASE_URL=$(printf %q "$r_base") "
  [[ -n "$r_token" ]] && launch_env+="ANTHROPIC_API_KEY=$(printf %q "$r_token") "
  tmux new-window -d -t "$SESSION" -n "$name" \
    "${launch_env}$agent 2>&1; echo NVWA_PANE_EXITED; exec sleep infinity"
  mkdir -p "$WORKERS_DIR"; printf '%s\n' "$r_tier" > "$WORKERS_DIR/$name.tier"
  log "$name: spawned ($agent, tier=$r_tier model=$r_model)"

  # wait for input box, then send mission
  if wait_input_box "$name"; then
    if [[ -n "$mission" ]]; then
      send_literal "$name" "$mission"
      log "$name: mission sent"
    fi
  else
    log "$name: input box never appeared (60s) — pane left for inspection"
  fi
  printf 'SPAWNED %s agent=%s tier=%s model=%s\n' "$name" "$agent" "$r_tier" "$r_model"
}

# ─── Language: say / listen ─────────────────────────────────────────────────
cmd_say() {
  local name="${1:-}" text="${2:-}"
  [[ -n "$name" && -n "$text" ]] || die 'usage: nvwa say <name> "<text>"'
  tmux has-session -t "$SESSION" 2>/dev/null || die "session '$SESSION' not running"
  tmux list-windows -t "$SESSION" -F '#W' | grep -qx -- "$name" || die "no such agent '$name'"
  send_literal "$name" "$text"
  log "say -> $name: ${text:0:60}"
}

cmd_listen() {
  local name="${1:-}" lines="${2:-40}"
  [[ -n "$name" ]] || die 'usage: nvwa listen <name> [lines=40]'
  tmux has-session -t "$SESSION" 2>/dev/null || die "session '$SESSION' not running"
  tmux list-windows -t "$SESSION" -F '#W' | grep -qx -- "$name" || die "no such agent '$name'"
  tmux capture-pane -p -t "$SESSION:$name" 2>/dev/null | tail -n "$lines"
}

# ─── Roster: list / kill ─────────────────────────────────────────────────────
cmd_list() {
  tmux has-session -t "$SESSION" 2>/dev/null || { echo "(no agents)"; return 0; }
  tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null | while read -r w; do
    [[ "$w" == "$(basename "$0")" ]] && continue
    local pane state="alive"
    pane=$(pane_text "$w" 2>/dev/null)
    printf '%s' "$pane" | grep -q 'NVWA_PANE_EXITED' && state="exited"
    printf '%-12s %s\n' "$w" "$state"
  done
}

cmd_kill() {
  local name="${1:-}"
  [[ -n "$name" ]] || die 'usage: nvwa kill <name>'
  rm -f "$WORKERS_DIR/$name.tier" 2>/dev/null
  tmux kill-window -t "$SESSION:$name" 2>/dev/null && log "killed $name" || log "kill: $name already gone"
}

# ─── Board: combined agent + graph overview ─────────────────────────────────
cmd_board() {
  echo "═══ agents ═══"
  cmd_list
  echo
  echo "═══ graph ═══"
  "$FGC" status 2>/dev/null || echo "(no graph — run: fgc init --goal \"...\")"
}

# ─── main dispatch ───────────────────────────────────────────────────────────
case "${1:-}" in
  spawn)  shift; cmd_spawn "$@" ;;
  say)    shift; cmd_say "$@" ;;
  listen) shift; cmd_listen "$@" ;;
  list)   shift; cmd_list "$@" ;;
  kill)   shift; cmd_kill "$@" ;;
  board)  shift; cmd_board "$@" ;;
  fleet)   shift; exec python3 "$SCRIPT_DIR/lib/fleet.py" "$@" ;;
  command) shift; exec python3 "$SCRIPT_DIR/lib/fleet.py" command "$@" ;;
  sweep)   shift; exec python3 "$SCRIPT_DIR/lib/fleet.py" sweep "$@" ;;
  help|-h|--help)
    cat <<'USAGE'
nvwa — the Nüwa Foundation CLI (Create + Language + History)

Create:
  spawn [--name NAME] [--agent CMD] [--mission "..."]    start a new AI agent
        [--role R] [--tier T] [--model M]                 --agent: any interactive CLI (default: claude)
                                                          --role/--tier/--model: pick the model tier
                                                          (default role: worker -> cheap). The resolved
                                                          model/endpoint are injected as ANTHROPIC_* env.
  kill <name>                                             stop an agent

Language:
  say <name> "<text>"                                     send text to an agent (Enter included)
  listen <name> [lines=40]                                read an agent's recent output

Roster:
  list                                                    all live agents
  board                                                   agents + graph state

Fleet (multi-graph commander — many per-unit graphs at once):
  fleet init <unit> --goal "..."                          create a unit graph
  fleet status [--budget B]                               cross-graph board
  command [--budget B]                                    one LLM allocation step (work/hire/fire/stop)
  sweep [--rounds R]                                      round-robin an auto slice over open units
  fleet up | fleet down                                   hire a worker per open unit | stop all

History (same as fgc — shared fact-intent graph):
  fact / intent / status / graph / frontier / recall / dispatch / auto / tier / ...
  All fgc commands pass through transparently.

Tiering (strong model for commander/hard work, cheap for the worker mass):
  fgc tier show                      inspect the resolved role->tier->model map
  fgc tier resolve --role commander  print the model a role resolves to
  Configure via FG_TIERS (inline JSON or a path); see doctrine/tiers.example.json
  and doctrine/commander-doctrine.md Part B. With no config it degrades to one
  model for every tier.

Environment:
  NVWA_SESSION      tmux session name (default: nvwa)
  NVWA_AGENT        default agent command for spawn (default: claude)
  NVWA_MAX_WORKERS  max concurrent agents (default: 8)
  FG_TIERS          model-tier map: inline JSON or a path to a JSON file
  FG_MODEL          default model when no tier map is configured (default: sonnet)
USAGE
    ;;
  *)
    # transparent delegation to fgc for all History commands
    if command -v "$FGC" >/dev/null 2>&1; then
      exec "$FGC" "$@"
    elif [[ -x "$SCRIPT_DIR/lib/fg.py" ]]; then
      exec python3 "$SCRIPT_DIR/lib/fg.py" "$@"
    else
      die "unknown command '${1:-}' and fgc not found"
    fi
    ;;
esac
